# Copy to .env and fill in what you need. All values have safe defaults.

# --- LLM (core/llm_agent.py) - local Ollama only ---
# Blank LLM_MODEL uses the default (ollama/qwen2.5:14b-instruct). Pull other
# models yourself via `ollama pull <name>` first.
LLM_MODEL=
# Blank LLM_API_BASE uses the local default (http://localhost:11434).
LLM_API_BASE=
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=800
LLM_TIMEOUT_S=60
LLM_MAX_RETRIES=3

# --- Subtitle ingestion (core/fetchers.py) ---
# Comma-separated, tried in priority order; first language with an actual track wins.
# Default (if unset) is "ru,ru-orig,en,en-orig" — native language first, falling back
# to YouTube's auto-translated English captions only if no Russian track exists.
SUBTITLE_LANGS=

# --- External binaries ---
TWITCH_DOWNLOADER_CLI_PATH=./bin/TwitchDownloaderCLI.exe
YTDLP_BINARY=yt-dlp

# --- DaVinci Resolve scripting API (exporters/davinci_api.py) ---
RESOLVE_SCRIPT_API=
RESOLVE_SCRIPT_LIB=

LOG_LEVEL=INFO
